/.tools/
/result
/mochil
/mochil.exe
/mochil-cache.json
/config/*
!/config/.gitkeep
/compose.override.yaml
/.env
/otherapps/
/node_modules/
/artifacts/browser-smoke/
/artifacts/releases/
/media/*
!/media/.gitkeep
/android/.gradle/
