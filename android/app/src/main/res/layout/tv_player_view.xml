<?xml version="1.0" encoding="utf-8"?>
<!-- The stock controller, whose focus handling suits a remote, dressed in the TV accent with a thicker, easier-to-see seek bar. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:show_timeout="5000"
    app:bar_height="6dp"
    app:touch_target_height="44dp"
    app:scrubber_enabled_size="18dp"
    app:scrubber_dragged_size="26dp"
    app:scrubber_color="#FFF0A35A"
    app:played_color="#FFF0A35A"
    app:buffered_color="#66FFFFFF"
    app:unplayed_color="#33FFFFFF" />
