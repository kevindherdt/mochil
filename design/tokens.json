{
  "$schema": "./tokens.schema.json",
  "meta": {
    "note": "The one source for colour, type, space, radius, shadow, motion and chrome sizing. Generated into web CSS and Android Kotlin by scripts/gen-tokens.mjs — never hand-edit the generated files, edit this and regenerate. Values below are extracted verbatim from internal/web/static/design-tokens.css and theme-tokens.css (the live 0.1.86 build) so the first generation is a no-op diff, proving the extraction is correct before anything is retuned.",
    "reference_theme": "kiln"
  },
  "radius": { "4": 4, "6": 6, "8": 8, "10": 10, "12": 12, "16": 16, "24": 24, "28": 28, "pill": 999 },
  "fontSize": { "10": 10, "11": 11.5, "12": 12.5, "13": 13, "14": 14, "16": 16, "18": 18, "22": 22, "26": 26, "30": 30 },
  "space": { "4": 4, "8": 8, "12": 12, "16": 16, "24": 24, "32": 32, "48": 48 },
  "motion": { "ease": "cubic-bezier(.2,.7,.2,1)", "durationFast": "0.15s", "duration": "0.28s" },
  "elevation": {
    "dark": { "rgb": "0 0 0", "alpha": 1 },
    "light": { "rgb": "107 80 53", "alpha": 0.55 },
    "eink": { "rgb": "0 0 0", "alpha": 0 },
    "steps": { "1": 0.22, "2": 0.3, "3": 0.4, "4": 0.53 }
  },
