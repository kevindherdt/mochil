# Copy this file to .env, optionally set authentication, then run:
# docker compose up -d

MOCHIL_PORT=8099

# Optional. Set both values to protect the catalog.
MOCHIL_USERNAME=
MOCHIL_PASSWORD=

# Required only when Settings uses an external KoSync provider.
MOCHIL_KOSYNC_USERNAME=
MOCHIL_KOSYNC_PASSWORD=

# Optional bounded media caches (MiB).
MOCHIL_HLS_CACHE_MB=4096
MOCHIL_AUDIO_HLS_CACHE_MB=2048
MOCHIL_VIDEO_ARTWORK_CACHE_MB=1024
MOCHIL_VIDEO_PREVIEW_CACHE_MB=512
MOCHIL_AUDIO_ARTWORK_CACHE_MB=512
MOCHIL_PODCAST_DOWNLOAD_CACHE_MB=20480

## Web-managed settings are stored here (relative paths resolve beside compose.yaml).
MOCHIL_CONFIG_PATH=./config
